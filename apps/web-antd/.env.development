# 端口号
VITE_PORT=5666

VITE_BASE=/

# 请求路径
VITE_BASE_URL=https://gateway-in.dev.rosino.com/dev/biz-mit-gw
# 接口地址（直连远端网关，不走 vite proxy）
VITE_GLOB_API_URL=https://gateway-in.dev.rosino.com/dev/biz-mit-gw/admin-api
# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持S3服务
VITE_UPLOAD_TYPE=server
# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 默认登录用户名
VITE_APP_DEFAULT_USERNAME=admin
# 默认登录密码
VITE_APP_DEFAULT_PASSWORD=admin123

# OneID 配置（dev 开发环境不接入 OneID，直接跳登录页）
# VITE_ONEID_ENABLED=false 表示该环境不走 OneID
VITE_ONEID_ENABLED=false
VITE_ONEID_URL=https://oneid-stg.rosino.com
VITE_ONEID_CLIENT_ID=6d45923d5cb3334bfe1a
